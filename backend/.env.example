# Copy to .env and fill in.

# Long random string. The iOS app sends it as X-API-Key. Generate with: openssl rand -hex 32
APP_API_KEY=

# From https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# WHISPER_MODEL=base
# MAX_CONCURRENT_JOBS=2

# Instagram usually blocks anonymous downloads. Export your browser cookies (Netscape format)
# for instagram.com and point this at the file to make IG reels work reliably.
# YTDLP_COOKIES_FILE=/secrets/cookies.txt
