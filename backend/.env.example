# Copy to .env and fill in.

# Long random string you type into the web app and the iPhone Shortcut. Generate with: openssl rand -hex 32
APP_API_KEY=

# From https://console.anthropic.com
ANTHROPIC_API_KEY=

# Finding places on the map. Without a Google key, free OpenStreetMap search is used.
# Google is better for restaurants and small shops, and adds ratings; enable "Places API (New)" and "Routes API" on it.
# GOOGLE_MAPS_API_KEY=
# Contact email Nominatim (OpenStreetMap) asks for in its usage policy.
# NOMINATIM_EMAIL=you@example.com

# Where the SQLite database lives (the Docker image defaults to /data/tripit.db).
# DATABASE_PATH=data/tripit.db

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# Read menu photos from Google Maps when a place's website has no menu (check Google's terms; false turns it off).
# MENU_GOOGLE_PHOTOS=true
# WHISPER_MODEL=base
# MAX_CONCURRENT_JOBS=2

# Instagram usually blocks anonymous downloads. Export your browser cookies (Netscape format)
# for instagram.com and point this at the file to make IG reels work reliably.
# YTDLP_COOKIES_FILE=/secrets/cookies.txt
