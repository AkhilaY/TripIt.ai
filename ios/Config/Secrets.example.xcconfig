// Copy this file to Secrets.xcconfig (gitignored) and fill it in.

// Your Apple Developer Team ID (Xcode > Settings > Accounts, or developer.apple.com > Membership).
TRIPIT_TEAM_ID = ABCDE12345

// Must be unique to you. The App Group becomes group.<this> and iCloud container iCloud.<this>.
TRIPIT_BUNDLE_ID = com.yourname.tripit

// Where the backend runs. NOTE: xcconfig treats "//" as a comment, so write the URL as https:/$()/...
TRIPIT_API_BASE_URL = https:/$()/your-tripit-backend.fly.dev

// Same value as APP_API_KEY in backend/.env
TRIPIT_API_KEY =
