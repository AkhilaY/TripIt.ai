// Copy this file to Secrets.xcconfig (gitignored) and fill it in.

// Your Apple Developer Team ID (Xcode > Settings > Accounts, or developer.apple.com > Membership).
TRIPIT_TEAM_ID = ABCDE12345

// Must be unique to you, e.g. com.yourname.tripit. The App Group becomes group.<this>.
TRIPIT_BUNDLE_ID = com.yourname.tripit

// Where TripIt runs. NOTE: xcconfig treats "//" as a comment, so write the URL as https:/$()/...
TRIPIT_API_BASE_URL = https:/$()/my-tripit.fly.dev

// The same address without https://, for the web view's allowed domain (it lets the app work offline).
TRIPIT_HOST = my-tripit.fly.dev

// Optional: crash and error reporting. A Sentry project's DSN, written as https:/$()/... like the URL above.
SENTRY_DSN_IOS =
